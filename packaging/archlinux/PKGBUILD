pkgname=amll-ttml-tool-git
pkgver=0.9.11.r1080.ge090733
pkgrel=1
pkgdesc="A brand-new syllable lyric editor for Apple Music-like lyrics"
arch=('x86_64')
options=(!lto)
url="https://github.com/olafix52/NaeNae-AMLL-TTML-TOOL"
license=('AGPL-3.0-only')
depends=(
  'cairo'
  'ffmpeg'
  'gdk-pixbuf2'
  'glib2'
  'gstreamer'
  'gst-plugins-bad'
  'gst-plugins-base'
  'gst-plugins-good'
  'gst-plugins-ugly'
  'gtk3'
  'libappindicator'
  'openssl'
  'pango'
  'webkit2gtk-4.1'
)
makedepends=('cargo' 'nodejs' 'pnpm' 'git')
provides=("amll-ttml-tool")
conflicts=("amll-ttml-tool")
source=(
  "NaeNae-AMLL-TTML-TOOL::git+https://github.com/olafix52/NaeNae-AMLL-TTML-TOOL.git#branch=main"
  "amll-ttml-tool.desktop"
)
sha256sums=(
  'SKIP'
  '6c3957f80f558b4f024381f75aab7676f5f12178718ac5399766ebdb3372555b'
)

pkgver() {
  cd NaeNae-AMLL-TTML-TOOL
  _ver=$(node -p "require('./package.json').version" 2>/dev/null || echo "0.9.11")
  _rev=$(git rev-list --count HEAD)
  _hash=$(git rev-parse --short=7 HEAD)
  printf "%s.r%s.g%s" "$_ver" "$_rev" "$_hash"
}

prepare() {
  cd NaeNae-AMLL-TTML-TOOL
  pnpm install --frozen-lockfile
}

build() {
  cd NaeNae-AMLL-TTML-TOOL
  pnpm tauri build --no-bundle
}

package() {
  cd NaeNae-AMLL-TTML-TOOL

  # Binarka aplikacji
  if [ -f "src-tauri/target/release/amll-ttml-tool" ]; then
    install -Dm755 "src-tauri/target/release/amll-ttml-tool" "$pkgdir/usr/bin/amll-ttml-tool"
  elif [ -f "target/release/amll-ttml-tool" ]; then
    install -Dm755 "target/release/amll-ttml-tool" "$pkgdir/usr/bin/amll-ttml-tool"
  fi

  # Ikony aplikacji
  install -Dm644 "src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/amll-ttml-tool.png"
  install -Dm644 "src-tauri/icons/64x64.png" "$pkgdir/usr/share/icons/hicolor/64x64/apps/amll-ttml-tool.png"
  install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/amll-ttml-tool.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/amll-ttml-tool.png"
  install -Dm644 "src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/amll-ttml-tool.png"

  # Skrót .desktop
  install -Dm644 "$srcdir/amll-ttml-tool.desktop" "$pkgdir/usr/share/applications/amll-ttml-tool.desktop"
}
