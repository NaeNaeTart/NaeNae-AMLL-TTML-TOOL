# Keep LF in the working tree on every OS, so biome and diffs agree on line
# endings regardless of core.autocrlf.
* text=auto eol=lf

/.yarn/**            linguist-vendored
/.yarn/releases/*    binary
/.yarn/plugins/**/*  binary
/.pnp.*              binary linguist-generated
src/modules/audio/assets/decode-audio.js linguist-generated
*.sh text eol=lf