{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"rewrites": [
		{
			"source": "/migration/assets/(.*)",
			"destination": "/assets/$1"
		},
		{
			"source": "/migration/(.*)",
			"destination": "/index.html"
		},
		{
			"source": "/boykisser/(.*)",
			"destination": "https://files.catbox.moe/$1"
		},
		{
			"source": "/api/spotify-embed/(.*)",
			"destination": "https://open.spotify.com/embed/$1"
		},
		{
			"source": "/api/spotify-pathfinder/(.*)",
			"destination": "https://api-partner.spotify.com/pathfinder/$1"
		},
		{
			"source": "/api/spotify-api/(.*)",
			"destination": "https://api.spotify.com/$1"
		},
		{
			"source": "/api/lrclib/(.*)",
			"destination": "https://lrclib.net/api/$1"
		},
		{
			"source": "/api/unison/(.*)",
			"destination": "https://unison.boidu.dev/$1"
		}
	],
	"headers": [
		{
			"source": "(.*)",
			"headers": [
				{
					"key": "Cross-Origin-Opener-Policy",
					"value": "same-origin"
				},
				{
					"key": "Cross-Origin-Embedder-Policy",
					"value": "require-corp"
				}
			]
		},
		{
			"source": "/migration/(.*)",
			"headers": [
				{
					"key": "Cross-Origin-Opener-Policy",
					"value": "unsafe-none"
				},
				{
					"key": "Cross-Origin-Embedder-Policy",
					"value": "unsafe-none"
				},
				{
					"key": "Cache-Control",
					"value": "no-store"
				}
			]
		}
	]
}
