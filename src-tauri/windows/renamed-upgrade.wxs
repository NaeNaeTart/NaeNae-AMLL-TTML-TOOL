<?xml version="1.0" encoding="utf-8"?>
<!--
  v0.10.0 and v0.10.1 shipped with the product name "NaeNae AMLL TTML Tool Fork". Tauri derives
  the MSI UpgradeCode from the product name, so those releases installed next to "AMLL TTML Tool"
  instead of upgrading it. The name (and its UpgradeCode, now pinned in tauri.windows.conf.json)
  is back, and this extra Upgrade entry makes MajorUpgrade's RemoveExistingProducts uninstall the
  renamed installs too.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Upgrade Id="{BBA144D7-F4BB-5E8A-80F7-A8915593BBC3}">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" Property="RENAMEDPRODUCTFOUND" />
    </Upgrade>
    <ComponentGroup Id="RenamedProductUpgrade" />
  </Fragment>
</Wix>
