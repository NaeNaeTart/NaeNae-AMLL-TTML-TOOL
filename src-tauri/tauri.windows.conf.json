{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"bundle": {
		"windows": {
			"wix": {
				"upgradeCode": "6AFCDBCF-4DCF-5CD9-9974-74985CB10E8D",
				"fragmentPaths": ["windows/renamed-upgrade.wxs"],
				"componentGroupRefs": ["RenamedProductUpgrade"]
			},
			"nsis": {
				"installerHooks": "windows/installer-hooks.nsh"
			}
		}
	},
	"app": {
		"windows": [
			{
				"title": "NaeNae's AMLL TTML Tool Fork",
				"label": "main",
				"width": 800,
				"height": 600,
				"minWidth": 640,
				"minHeight": 480,
				"resizable": true,
				"fullscreen": false,
				"transparent": true,
				"visible": false,
				"decorations": false,
				"center": true,
				"devtools": true,
				"dragDropEnabled": false,
				"browserExtensionsEnabled": true,
				"windowEffects": {
					"effects": ["tabbed", "mica"]
				}
			}
		]
	}
}
